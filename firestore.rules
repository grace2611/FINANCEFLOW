rules_version = '2';

// Reglas de Cloud Firestore para FinanceFlow.
// Cada usuario solo puede leer y escribir su propio documento: users/{su uid}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
